{
	"compilerOptions": {
		"target": "ES2018",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"strictPropertyInitialization": false,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
